# Turns the CIE CSVs into a C++ include at configure time:
#   kCmf[][4] = { nm, xbar, ybar, zbar }   (CIE_xyz_1931_2deg.csv)
#   kD65[][2] = { nm, S }                  (CIE_std_illum_D65.csv)
# The numbers are copied as written, so the compiler reads them exactly as
# the harness's own strtod does (and nothing is rounded on the way).
function(bubble_cie_tables source_dir out_file)
    set(text "// Generated by cmake/CieTables.cmake from data/*.csv (CIE, CC BY-SA 4.0). Do not edit.\n")
    foreach(spec "kCmf;CIE_xyz_1931_2deg.csv;4" "kD65;CIE_std_illum_D65.csv;2")
        list(GET spec 0 name)
        list(GET spec 1 file)
        list(GET spec 2 columns)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source_dir}/data/${file}")
        file(STRINGS "${source_dir}/data/${file}" lines)
        string(APPEND text "const double ${name}[][${columns}] = {\n")
        foreach(line IN LISTS lines)
            string(STRIP "${line}" line)
            if(line STREQUAL "")
                continue()
            endif()
            string(REPLACE "," ", " row "${line}")
            string(APPEND text "\t{ ${row} },\n")
        endforeach()
        string(APPEND text "};\n")
    endforeach()
    file(WRITE "${out_file}.tmp" "${text}")
    file(COPY_FILE "${out_file}.tmp" "${out_file}" ONLY_IF_DIFFERENT)
endfunction()
